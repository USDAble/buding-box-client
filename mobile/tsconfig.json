{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    // OCTO-FORK: 移动端壳的品牌插值 — see dev-docs-usdable/开发规范.md §3.2
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "capacitor.config.ts"]
}
