# OCTO-FORK: 本 fork 的生成物折叠规则（brand.json 的七份副本）与上游的 iconify 数据规则并存 —
# see dev-docs-usdable/需求/2260906/品牌升级方案.md §"生成目标全部进版本库"
#
# Generated by scripts/sync-branding.mjs from branding/brand.json. Committed so
# that `go build` / `vite build` / Inno Setup work from a plain clone without a
# Node step, but collapsed in review so a brand change reads as one edit to the
# source of truth rather than seven near-identical diffs.
#
# linguist-generated implies both `-diff` (collapsed in review) and
# `linguist-vendored` (excluded from language statistics).
internal/brand/brand.json             linguist-generated=true
web/src/lib/brand.config.json         linguist-generated=true
mobile/src/brand.config.json          linguist-generated=true
landing/brand.config.json             linguist-generated=true
cmd/octo-relay/internal/push/brand.json linguist-generated=true
packaging/windows/brand.iss           linguist-generated=true

# Generated icon data: one long JSON line, produced by web/scripts/gen-icons.mjs.
# Collapse it in diffs and keep it out of language stats — reviewing it by eye
# is neither possible nor useful; icons.generated.test.ts is what checks it.
web/src/lib/icons.generated.ts linguist-generated=true
