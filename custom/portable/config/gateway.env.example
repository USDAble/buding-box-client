# Copy this file to gateway.env in the same directory and set the endpoint.
# Keep the real API key out of this file; the launcher does not request it at startup.
AI_GUARD_UPSTREAM_URL=https://api.openai.com
# 便携版固定使用该策略模型标识，不再在启动时询问模型名称。
# 若实际供应商使用不同模型，只需在此处改值，不需要打开桌面端配置页。
AI_GUARD_UPSTREAM_MODEL=portable-approved-model
